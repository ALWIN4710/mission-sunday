# ============================================================
# Mission Sunday — Environment Configuration Template
# Copy this file to .env:
#   cp .env.example .env
# ============================================================

NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173

# Optional: MongoDB Atlas connection string.
# In development, leave blank to use the built-in embedded in-memory MongoDB.
MONGODB_URI=

JWT_SECRET=mission-sunday-church-fundraising-jwt-secret-key-production-ready-2026-secure
JWT_EXPIRES_IN=8h

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Default bootstrap credentials for initial admin
INITIAL_ADMIN_NAME=Admin User
INITIAL_ADMIN_EMAIL=admin@missionsunday.church
INITIAL_ADMIN_PASSWORD=Admin@123456

EVENT_NAME=Mission Sunday
TIMEZONE=Asia/Kolkata
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=50
LOG_LEVEL=info
