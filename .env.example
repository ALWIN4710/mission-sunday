# ============================================================
# Mission Sunday — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---- Server ------------------------------------------------
NODE_ENV=development
PORT=5000

# ---- Client ------------------------------------------------
# URL of the frontend (used for CORS)
CLIENT_URL=http://localhost:5173

# ---- Database ----------------------------------------------
# MongoDB Atlas connection string
# Create a free cluster at https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# ---- Authentication ----------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Cookie settings
COOKIE_SECURE=false          # Set to true in production (HTTPS only)
COOKIE_SAME_SITE=lax         # Use 'none' only with COOKIE_SECURE=true

# ---- Admin Bootstrap ---------------------------------------
# Used ONCE by the bootstrap-admin script to create the first admin account.
# Remove or clear after first run. Never set a guessable password.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ---- Logging -----------------------------------------------
LOG_LEVEL=info               # debug | info | warn | error

# ---- Rate Limiting -----------------------------------------
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ---- App Settings ------------------------------------------
# These are defaults; all can be overridden via the Settings page in the UI.
EVENT_NAME=Mission Sunday
TIMEZONE=Asia/Kolkata
